{
  "name": "macstodian",
  "version": "1.0.0",
  "private": true,
  "description": "A local, conservative macOS storage inspector",
  "main": "out/main/index.js",
  "author": "Macstodian",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "resolutions": {
    "extract-zip/yauzl": "3.3.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test tests/release-process.test.mjs",
    "build": "yarn typecheck && electron-vite build",
    "package": "yarn build && electron-builder --mac dir",
    "dist": "yarn build && electron-builder --mac dmg --publish never",
    "verify:mac": "node scripts/verify-mac.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.github.bloomkd46.macstodian",
    "productName": "Macstodian",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "icon": "assets/icon.svg",
      "notarize": false,
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Macstodian"
    }
  }
}
