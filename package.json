{
  "name": "macstodian",
  "version": "1.4.1-beta.1",
  "private": true,
  "description": "A local, conservative macOS storage inspector",
  "main": "out/main/index.js",
  "author": "Macstodian",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test tests/release-process.test.mjs",
    "build": "yarn typecheck && electron-vite build",
    "package": "yarn build && electron-builder --mac dir",
    "dist": "yarn build && electron-builder --mac dmg --publish never",
    "verify:mac": "node scripts/verify-mac.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "io.github.bloomkd46.macstodian",
    "productName": "Macstodian",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Macstodian asks Finder to move a selected item to Trash only after you approve a retry following a permission error."
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "icon": "assets/icon.svg",
      "notarize": false,
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Macstodian"
    }
  }
}